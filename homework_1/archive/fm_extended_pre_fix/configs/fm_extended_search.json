  "maximum_validation_evaluations": 60,
  "selection": "maximum macro validation NDCG@10 across registered checkpoints; ties: fewer epochs, then trial ID",
  "promotion": "top 4 distinct configurations by their best stage-1 checkpoint under the selection rule; continue epoch 12 state with AdaGrad accumulators and shuffle RNG",
  "features": "unchanged dated metadata temporal_metadata_v2; one train-only feature vocabulary/representation at 2016-01-01",
  "sampler_policy": "unseen negatives exclude ALL observed train pairs, including ratings 1-3; no future exclusion; replacement permitted; seed=137+zero-based epoch when resampling",
  "popularity_proposal": "q(i) proportional to (positive_train_item_count+1)^0.75, then rejection of user seen items; full fit catalog support; biased training proposal, no claim of unbiased correction",
  "bce": "observed rating>=4 positive, observed 1-3 negative plus r unseen negative per positive; exact frozen v2 BCE/regularization/AdaGrad",
  "bpr": "each observed positive versus r sampled unseen items; observed low ratings excluded from unseen proposal, not additional BPR pairs; log(1+exp(-(FM(u,i+)-FM(u,i-)))) plus mean active-feature L2 across both sides; global bias cancels",
  "probe": "BCE on a fixed 8192-example training-only probe; BPR logits not calibrated, probe BCE not compared across objectives for selection",
  "test_policy": "do not read test examples, final-test artifacts or final results; no train+validation refit; v2 final reports/lock remain unchanged",
  "baseline_control": "00 uses exact old fixed uniform sample, batch size, initialization, AdaGrad and seeds; epoch 12 must reproduce saved v2 validation score",
  "scope": "validation research after previous test observations; results are not an independent generalization estimate; budgets will not be expanded based on observed scores"
}
